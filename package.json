{
  "name": "retro-messenger",
  "private": true,
  "version": "1.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:build:windows": "tauri build --bundles nsis",
    "test:games": "node tests/verify-games.cjs",
    "updater:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/setup-updater.ps1",
    "updater:verify": "node ./scripts/verify-updater-config.mjs",
    "desktop:build:signed": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-signed-release.ps1"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.0",
    "@tauri-apps/api": "^2.8.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "@tauri-apps/plugin-updater": "^2.0.0",
    "@tauri-apps/plugin-process": "^2.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "~5.9.2",
    "vite": "^6.3.0"
  }
}
