import { useCallback, useEffect, useMemo, useRef, useState } from 'react';
import { isTauri } from '@tauri-apps/api/core';
import { WebviewWindow } from '@tauri-apps/api/webviewWindow';
import { LogIn, MessageCircle, UserRoundPlus, Settings, Send, Smile, Circle, X, Search, ChevronDown, LogOut, Bell, Monitor, Minus, Square, Camera, Trash2, Zap, Download, Palette, Volume2, VolumeX } from 'lucide-react';
import type { User } from '@supabase/supabase-js';
import { configured, supabase, readableError, type Profile, type Request, type Message } from './client';

type Status = Profile['status_preference'];
type InterfaceFont = 'tahoma'|'verdana'|'arial'|'trebuchet';
type MessageFont = 'ms-sans'|'tahoma'|'comic'|'verdana'|'georgia';
const chatQuery = new URLSearchParams(window.location.search).get('chat');
const display = (p:Profile) => p.display_name || p.username;
const dateTime = (d:string) => new Date(d).toLocaleTimeString([], { hour:'2-digit',minute:'2-digit' });
const EMOTES=[['🙂',':)'],['😃',':D'],['😉',';)'],['😛',':P'],['😢',":'("],['❤️','<3'],['😎','8-)'],['😮',':O'],['😂',':lol:'],['👍','(y)'],['😡',':@'],['🤗',':hug:']];
function EmoteText({body}:{body:string}) {const expression=/(:lol:|:hug:|8-\)|:\)|:D|;\)|:P|:'\(|<3|:O|\(y\)|:@)/gi;return <>{body.split(expression).map((part,i)=><span key={i}>{EMOTES.find(item=>item[1].toLowerCase()===part.toLowerCase())?.[0]||part}</span>)}</>}
type ChatEvent={id:string,conversation_id:string,sender_id:string,kind:string,created_at:string};
function soundNotification(){try {const AudioCtor=window.AudioContext;if(!AudioCtor)return;const ctx=new AudioCtor();const oscillator=ctx.createOscillator();const gain=ctx.createGain();oscillator.type='sine';oscillator.frequency.setValueAtTime(660,ctx.currentTime);oscillator.frequency.setValueAtTime(880,ctx.currentTime+.09);gain.gain.setValueAtTime(.035,ctx.currentTime);gain.gain.exponentialRampToValueAtTime(.001,ctx.currentTime+.19);oscillator.connect(gain);gain.connect(ctx.destination);oscillator.start();oscillator.stop(ctx.currentTime+.2);oscillator.onended=()=>void ctx.close()}catch{/* Browser audio may be unavailable until a user gesture. */}}


function Header({children}:{children:React.ReactNode}) {return <div className="xp-title"><div className="xp-title-name"><MessageCircle size={16}/>{children}</div><div className="window-symbols"><Minus size={13}/><Square size={12}/><X size={13}/></div></div>}
function Avatar({person,small=false}:{person:Profile,small?:boolean}) {return <div className={'avatar'+(small?' small':'')}>{person.avatar_url?<img src={person.avatar_url} alt={display(person)+' profile picture'} loading="lazy" referrerPolicy="no-referrer"/>:display(person)[0]?.toUpperCase()}</div>}
function StatusDot({status}:{status:Status|'offline'}) {return <span className={'status-dot '+status} title={status}/>}

function Login({onLogin,interfaceFont}:{onLogin:(u:User)=>void,interfaceFont:InterfaceFont}) {
  const [register,setRegister]=useState(false),[email,setEmail]=useState(''),[password,setPassword]=useState(''),[username,setUsername]=useState(''),[displayName,setDisplayName]=useState(''),[busy,setBusy]=useState(false),[notice,setNotice]=useState('');
  async function submit(e:React.FormEvent) {e.preventDefault();if(!supabase)return;setBusy(true);setNotice('');try{
    if(register){
      const handle=username.trim().toLowerCase();if(!/^[a-z0-9_]{3,20}$/.test(handle))throw Error('Username must be 3–20 letters, numbers or underscores.');
      const {data,error}=await supabase.auth.signUp({email,password,options:{data:{username:handle,display_name:displayName.trim()||handle}}});
      if(error)throw error;
      if(data.session?.user)onLogin(data.session.user);else setNotice('Account created. Check your email to confirm it, then sign in.');
    }else {const {data,error}=await supabase.auth.signInWithPassword({email,password});if(error)throw error;if(data.user)onLogin(data.user);}
  } catch(err){setNotice(readableError(err));}finally{setBusy(false);}}
  return <div className="page-center login-page" data-interface-font={interfaceFont}><section className="xp-window login-window msn-login-window"><Header>Retro Messenger — Sign In</Header><div className="menu-bar compact"><span>File</span><span>Contacts</span><span>Actions</span><span>Tools</span><span>Help</span></div><div className="login-body"><div className="login-brand"><div className="logo-round"><MessageCircle size={39}/></div><div><h1>Retro Messenger</h1><p className="subtitle">A little piece of the 2000s, made for today.</p></div></div><form onSubmit={submit} className="stack-form login-stack">
    {register && <><label>Username<input required value={username} maxLength={20} onChange={e=>setUsername(e.target.value)} placeholder="yourname2005" autoComplete="username"/></label><label>Display name<input value={displayName} maxLength={40} onChange={e=>setDisplayName(e.target.value)} placeholder="Your display name"/></label></>}
    <label>Email address<input type="email" required value={email} onChange={e=>setEmail(e.target.value)} placeholder="you@example.com" autoComplete="email"/></label><label>Password<input type="password" required minLength={6} value={password} onChange={e=>setPassword(e.target.value)} autoComplete={register?'new-password':'current-password'}/></label>
    <div className="login-footer-actions"><button className="xp-button primary" disabled={busy}>{busy?'Please wait…':register?'Create account':'Sign In'} <LogIn size={15}/></button><button type="button" className="link-button" onClick={()=>{setRegister(!register);setNotice('')}}>{register?'Already have an account? Sign in':'New here? Create an account'}</button></div></form>
    {notice && <p className="notice" role="status">{notice}</p>}<p className="fineprint">Sign in with your Retro Messenger account to see your contacts.</p></div></section></div>;
}

export default function App() {
  const [user,setUser]=useState<User|null>(null),[loading,setLoading]=useState(true),[profile,setProfile]=useState<Profile|null>(null);
  const [profiles,setProfiles]=useState<Profile[]>([]),[contactIds,setContactIds]=useState<string[]>([]),[requests,setRequests]=useState<Request[]>([]),[blocked,setBlocked]=useState<string[]>([]);
  const [search,setSearch]=useState(''),[openChats,setOpenChats]=useState<string[]>([]),[active,setActive]=useState<string|null>(null),[messages,setMessages]=useState<Record<string,Message[]>>({});
  const [drafts,setDrafts]=useState<Record<string,string>>({}),[chatMap,setChatMap]=useState<Record<string,string>>({}),[error,setError]=useState(''),[settings,setSettings]=useState(false),[newDisplay,setNewDisplay]=useState(''),[newPersonal,setNewPersonal]=useState(''),[newAvatar,setNewAvatar]=useState<File|null>(null),[avatarPreview,setAvatarPreview]=useState<string|null>(null),[removeAvatar,setRemoveAvatar]=useState(false),[avatarError,setAvatarError]=useState('');
  const [pending,setPending]=useState(false),[onlineIds,setOnlineIds]=useState<Set<string>>(new Set());
  const [events,setEvents]=useState<Record<string,ChatEvent[]>>({});
  const [emoteOpen,setEmoteOpen]=useState<string|null>(null);
  const [chatStyle,setChatStyle]=useState<'blue'|'rose'|'mint'>(()=>(localStorage.getItem('retro-style') as 'blue'|'rose'|'mint')||'blue');
  const [interfaceFont,setInterfaceFont]=useState<InterfaceFont>(()=>(localStorage.getItem('retro-interface-font') as InterfaceFont)||'tahoma');
  const [messageFont,setMessageFont]=useState<MessageFont>(()=>(localStorage.getItem('retro-message-font') as MessageFont)||'ms-sans');
  const [soundEnabled,setSoundEnabled]=useState(()=>localStorage.getItem('retro-sounds')!=='off');
  const [settingsTab,setSettingsTab]=useState<'personal'|'appearance'|'sounds'>('personal');
  const [groupMap,setGroupMap]=useState<Record<string,string>>({});
  const [nudgeAt,setNudgeAt]=useState<Record<string,number>>({});
  const [shaking,setShaking]=useState<string|null>(null);
  const [cropping,setCropping]=useState(false),[cropZoom,setCropZoom]=useState(1);
  const cropCanvas=useRef<HTMLCanvasElement>(null);
  useEffect(()=>{localStorage.setItem('retro-style',chatStyle)},[chatStyle]);
  useEffect(()=>{localStorage.setItem('retro-interface-font',interfaceFont)},[interfaceFont]);
  useEffect(()=>{localStorage.setItem('retro-message-font',messageFont)},[messageFont]);
  useEffect(()=>{localStorage.setItem('retro-sounds',soundEnabled?'on':'off')},[soundEnabled]);
  useEffect(()=>{if(user){try{setGroupMap(JSON.parse(localStorage.getItem(`retro-groups-${user.id}`)||'{}'))}catch{setGroupMap({})}}},[user?.id]);
  const setGroup=(contactId:string,group:string)=>setGroupMap(old=>{const next={...old,[contactId]:group};if(user)localStorage.setItem(`retro-groups-${user.id}`,JSON.stringify(next));return next});
  const shake=useCallback((id:string)=>{setShaking(id);window.setTimeout(()=>setShaking(current=>current===id?null:current),650)},[]);
  const alive=useRef(true);
  useEffect(()=>{alive.current=true;if(!supabase){setLoading(false);return;}const client=supabase;client.auth.getUser().then(({data})=>{if(alive.current){setUser(data.user??null);setLoading(false)}});const {data:{subscription}}=client.auth.onAuthStateChange((_event,session)=>{if(alive.current){setUser(session?.user??null);setLoading(false)}});return()=>{alive.current=false;subscription.unsubscribe()}},[]);
  const load = useCallback(async()=>{if(!supabase||!user)return;const s=supabase;try{
    const [p,c,r,b,all]=await Promise.all([
      s.from('profiles').select('*').eq('id',user.id).single(),
      s.from('contacts').select('contact_id').eq('user_id',user.id),
      s.from('contact_requests').select('*').or(`sender_id.eq.${user.id},receiver_id.eq.${user.id}`).eq('status','pending'),
      s.from('user_blocks').select('blocked_id').eq('blocker_id',user.id),
      s.from('profiles').select('*').order('username',{ascending:true}).limit(300)
    ]);
    for(const x of [p,c,r,b,all])if(x.error)throw x.error;
    setProfile(p.data as Profile);setContactIds((c.data??[]).map(x=>x.contact_id));setRequests((r.data??[]) as Request[]);setBlocked((b.data??[]).map(x=>x.blocked_id));setProfiles((all.data??[]) as Profile[]);
  }catch(e){setError(readableError(e));}},[user]);
  useEffect(()=>{if(!user)return;void load();const timer=setInterval(()=>void load(),30000);return()=>clearInterval(timer)},[user,load]);
  useEffect(()=>{if(!user||!supabase)return;const s=supabase;const channel=s.channel(`user-db-${user.id}`).on('postgres_changes',{event:'*',schema:'public',table:'contact_requests',filter:`receiver_id=eq.${user.id}`},()=>void load()).on('postgres_changes',{event:'*',schema:'public',table:'contacts',filter:`user_id=eq.${user.id}`},()=>void load()).subscribe();return()=>{void s.removeChannel(channel)}},[user,load]);
  // Presence is deliberately not a public roster. In the MVP, presence is only
  // shared between accepted contacts through authorised per-user channels.
  useEffect(()=>{if(!user||!supabase||!profile)return;const s=supabase;let cancelled=false;
    const subscriptions:ReturnType<typeof s.channel>[]=[];
    const mine=s.channel(`presence-${user.id}`,{config:{private:true,presence:{key:user.id}}});
    mine.on('presence',{event:'sync'},()=>{}).subscribe(async status=>{if(status==='SUBSCRIBED'&&!cancelled){await mine.track({status:profile.status_preference,at:Date.now()})}});subscriptions.push(mine);
    const seen=new Set<string>();for(const id of contactIds){const ch=s.channel(`presence-${id}`,{config:{private:true}});ch.on('presence',{event:'sync'},()=>{const state=ch.presenceState();if(Object.values(state).some(items=>items.some((i:unknown)=>typeof i==='object' && i!==null && (i as {status?:string}).status!=='invisible')))seen.add(id);else seen.delete(id);setOnlineIds(new Set(seen))});ch.subscribe();subscriptions.push(ch)}
    return()=>{cancelled=true;subscriptions.forEach(ch=>{void s.removeChannel(ch)})};
  },[user?.id,profile?.status_preference,contactIds.join(',')]);
  const contacts=useMemo(()=>profiles.filter(p=>contactIds.includes(p.id)&&!blocked.includes(p.id)),[profiles,contactIds,blocked]);
  const requestedByMe=new Set(requests.filter(r=>r.sender_id===user?.id).map(r=>r.receiver_id));
  const received=requests.filter(r=>r.receiver_id===user?.id);
  const candidates=profiles.filter(p=>p.id!==user?.id&&!contactIds.includes(p.id)&&!blocked.includes(p.id)&&p.username.toLowerCase().includes(search.toLowerCase())).slice(0,12);
  function buddyStatus(p:Profile):Status|'offline' {return onlineIds.has(p.id)?p.status_preference==='invisible'?'offline':p.status_preference:'offline'}
  async function act<T>(work:()=>Promise<T>,after=true) {setPending(true);setError('');try{await work();if(after)await load()}catch(e){setError(readableError(e))}finally{setPending(false)}}
  async function requestContact(id:string){if(!supabase||!user)return;await act(async()=>{const {error}=await supabase!.from('contact_requests').insert({sender_id:user.id,receiver_id:id});if(error)throw error;})}
  async function respond(id:string,accept:boolean){if(!supabase)return;await act(async()=>{const {error}=await supabase!.rpc('respond_contact_request',{request_id:id,accept_request:accept});if(error)throw error;})}
  async function removeContact(id:string){if(!supabase||!user)return;await act(async()=>{const {error}=await supabase!.rpc('remove_contact',{other_user:id});if(error)throw error;setOpenChats(old=>old.filter(x=>x!==id) )})}
  async function blockContact(id:string){if(!supabase||!user)return;await act(async()=>{const {error}=await supabase!.from('user_blocks').insert({blocker_id:user.id,blocked_id:id});if(error)throw error;setOpenChats(old=>old.filter(x=>x!==id))})}
  const loadChat=useCallback(async(id:string)=>{if(!supabase)return;const s=supabase;try{
    const {data:cid,error:e}=await s.rpc('get_or_create_dm',{other_user:id});if(e)throw e;const conversation=cid as string;setChatMap(old=>({...old,[id]:conversation}));
    const {data,error}=await s.from('messages').select('*').eq('conversation_id',conversation).order('created_at',{ascending:true}).limit(200);if(error)throw error;
    setMessages(old=>({...old,[id]:(data??[]) as Message[]}));
  }catch(e){setError(readableError(e))}},[]);
  useEffect(()=>{if(!active)return;void loadChat(active)},[active,loadChat]);
  useEffect(()=>{if(!supabase||!active||!chatMap[active])return;const s=supabase;const id=active;const conversation=chatMap[id];const ch=s.channel(`dm-${conversation}`).on('postgres_changes',{event:'INSERT',schema:'public',table:'messages',filter:`conversation_id=eq.${conversation}`},payload=>{const entry=payload.new as Message;if(entry.sender_id!==user?.id&&soundEnabled)soundNotification();setMessages(old=>({...old,[id]:[...(old[id]??[]).filter(m=>m.id!==entry.id),entry]}))}).subscribe();return()=>{void s.removeChannel(ch)}},[active,chatMap,user?.id,soundEnabled]);
  useEffect(()=>{if(!supabase||!active||!chatMap[active])return;const s=supabase;const friendId=active;const conversation=chatMap[friendId];
    void s.from('chat_events').select('*').eq('conversation_id',conversation).order('created_at',{ascending:false}).limit(20).then(({data})=>{if(data)setEvents(old=>({...old,[friendId]:[...data].reverse() as ChatEvent[]}))});
    const ch=s.channel(`events-${conversation}`).on('postgres_changes',{event:'INSERT',schema:'public',table:'chat_events',filter:`conversation_id=eq.${conversation}`},payload=>{const item=payload.new as ChatEvent;setEvents(old=>({...old,[friendId]:[...(old[friendId]||[]).filter(x=>x.id!==item.id),item]}));if(item.sender_id!==user?.id){shake(friendId);if(soundEnabled)soundNotification()}}).subscribe();
    return()=>{void s.removeChannel(ch)};
  },[active,chatMap,user?.id,soundEnabled,shake]);
  async function nudge(id:string){if(!supabase||!user)return;const now=Date.now();if(now-(nudgeAt[id]||0)<15000){setError('You can only send a nudge once every 15 seconds.');return;}try{let cid=chatMap[id];if(!cid){const {data,error}=await supabase.rpc('get_or_create_dm',{other_user:id});if(error)throw error;cid=data as string;setChatMap(old=>({...old,[id]:cid}))}const {data,error}=await supabase.from('chat_events').insert({conversation_id:cid,sender_id:user.id,kind:'nudge'}).select('*').single();if(error)throw error;setNudgeAt(old=>({...old,[id]:now}));setEvents(old=>({...old,[id]:[...(old[id]||[]).filter(x=>x.id!==data.id),data as ChatEvent]}));shake(id)}catch(e){setError(readableError(e))}}
  function exportChat(id:string){const friend=contacts.find(x=>x.id===id);if(!friend)return;const content=(messages[id]||[]).map(m=>`[${new Date(m.created_at).toLocaleString()}] ${m.sender_id===user?.id?display(profile!):display(friend)}: ${m.body}`).join('\n');const blob=new Blob([`Retro Messenger - ${display(friend)}\n\n${content}`],{type:'text/plain;charset=utf-8'});const url=URL.createObjectURL(blob);const a=document.createElement('a');a.href=url;a.download=`retro-chat-${friend.username}.txt`;a.click();window.setTimeout(()=>URL.revokeObjectURL(url),1000)}
  function insertEmote(id:string,shortcut:string){setDrafts(old=>({...old,[id]:(old[id]||'')+shortcut}));setEmoteOpen(null)}
  async function cropImage(){if(!newAvatar||!avatarPreview)return;const image=new window.Image();image.src=avatarPreview;await image.decode();const canvas=cropCanvas.current||document.createElement('canvas');canvas.width=256;canvas.height=256;const ctx=canvas.getContext('2d');if(!ctx)return;const square=Math.min(image.naturalWidth,image.naturalHeight)/cropZoom;const x=(image.naturalWidth-square)/2,y=(image.naturalHeight-square)/2;ctx.clearRect(0,0,256,256);ctx.drawImage(image,x,y,square,square,0,0,256,256);const blob=await new Promise<Blob|null>(resolve=>canvas.toBlob(resolve,'image/png'));if(!blob)return;setNewAvatar(new File([blob],'avatar.png',{type:'image/png'}));setCropping(false);setCropZoom(1)}
  async function openChat(id:string){setActive(id);setOpenChats(old=>old.includes(id)?old:[...old,id]);if(isTauri()&&!chatQuery){try{const label=`chat-${id.replace(/[^a-zA-Z0-9]/g,'')}`;const already=await WebviewWindow.getByLabel(label);if(already){await already.setFocus();return;}const child=new WebviewWindow(label,{url:`/?chat=${encodeURIComponent(id)}`,title:'Retro Messenger — Chat',width:540,height:500,minWidth:400,minHeight:360});child.once('tauri://error', e=>setError(String(e)));}catch(e){setError(readableError(e))}}}
  async function send(id:string){if(!supabase||!user)return;const text=(drafts[id]??'').trim();if(!text||text.length>2000)return;setDrafts(old=>({...old,[id]:''}));try{let conversation=chatMap[id];if(!conversation){const {data,error}=await supabase.rpc('get_or_create_dm',{other_user:id});if(error)throw error;conversation=data as string;setChatMap(old=>({...old,[id]:conversation}))}const {data,error}=await supabase.from('messages').insert({conversation_id:conversation,sender_id:user.id,body:text}).select('*').single();if(error)throw error;setMessages(old=>({...old,[id]:[...(old[id]??[]).filter(m=>m.id!==data.id),data as Message]}))}catch(e){setDrafts(old=>({...old,[id]:text}));setError(readableError(e))}}
  function openSettings(){if(!profile)return;setNewDisplay(profile.display_name);setNewPersonal(profile.personal_message);setNewAvatar(null);setAvatarPreview(null);setRemoveAvatar(false);setCropping(false);setAvatarError('');setSettingsTab('personal');setSettings(true)}
  function selectAvatar(file:File|undefined){if(!file)return;setAvatarError('');
    if(!['image/jpeg','image/png','image/webp'].includes(file.type)){setAvatarError('Choose a JPG, PNG, or WebP picture.');return;}
    if(file.size>2*1024*1024){setAvatarError('Profile pictures must be 2 MB or smaller.');return;}
    setNewAvatar(file);setRemoveAvatar(false);setCropping(true);setCropZoom(1);
  }
  useEffect(()=>{if(!newAvatar){setAvatarPreview(null);return;}const url=URL.createObjectURL(newAvatar);setAvatarPreview(url);return()=>URL.revokeObjectURL(url)},[newAvatar]);
  async function saveProfile(e:React.FormEvent){e.preventDefault();if(!supabase||!user)return;await act(async()=>{
    const updates:{display_name:string,personal_message:string,avatar_url?:string|null}={display_name:newDisplay.trim(),personal_message:newPersonal.trim()};
    if(removeAvatar)updates.avatar_url=null;
    if(newAvatar){
      const ext=({'image/jpeg':'jpg','image/png':'png','image/webp':'webp'} as Record<string,string>)[newAvatar.type];
      if(!ext||newAvatar.size>2*1024*1024)throw Error('Choose a JPG, PNG, or WebP under 2 MB.');
      const path=`${user.id}/${crypto.randomUUID()}.${ext}`;
      const {error:uploadError}=await supabase!.storage.from('avatars').upload(path,newAvatar,{contentType:newAvatar.type,upsert:false});
      if(uploadError)throw uploadError;
      const {data}=supabase!.storage.from('avatars').getPublicUrl(path);
      updates.avatar_url=data.publicUrl;
    }
    const {error}=await supabase!.from('profiles').update(updates).eq('id',user.id);
    if(error)throw error;
    setSettings(false);setNewAvatar(null);setRemoveAvatar(false);
  })}
  async function setStatus(status:Status){if(!supabase||!user)return;await act(async()=>{const {error}=await supabase!.from('profiles').update({status_preference:status}).eq('id',user.id);if(error)throw error})}
  async function logout(){await supabase?.auth.signOut();setProfile(null);setActive(null);setOpenChats([])}
  if(!configured)return <div className="page-center"><div className="xp-window setup"><Header>Retro Messenger — Setup</Header><div className="setup-body"><Monitor size={40} color="#4384cb"/><h2>Connect your Supabase project</h2><p>Copy <code>.env.example</code> to <code>.env</code> and add your Supabase project URL and publishable key. Then run the SQL migration and restart the dev server.</p><p>See <strong>README.md</strong> for step-by-step instructions.</p></div></div></div>;
  if(loading)return <div className="page-center">Connecting to Messenger…</div>;
  if(!user)return <Login onLogin={setUser} interfaceFont={interfaceFont}/>;
  if(!profile)return <div className="page-center"><div className="xp-window setup"><Header>Loading profile…</Header><div className="setup-body"><p>{error||'Loading your messenger account. If you just registered, check your email verification and run the database migration.'}</p><button className="xp-button" onClick={()=>void load()}>Try again</button><button className="xp-button" onClick={()=>void logout()}>Sign out</button></div></div></div>;
  const showOnlyChat=Boolean(chatQuery&&contacts.some(c=>c.id===chatQuery));
  if(chatQuery&&!showOnlyChat)return <div className="page-center"><p>This conversation is not available. Open it from your contact list.</p></div>;
  const chatView=(id:string)=>{const friend=contacts.find(c=>c.id===id);if(!friend)return null;return <div className={'xp-window chat-window theme-'+chatStyle+(shaking===id?' nudge-shake':'')} key={id}><Header>{display(friend)} — Conversation</Header><div className="chat-banner"><Avatar person={friend} small/><div><strong>{display(friend)}</strong><span><StatusDot status={buddyStatus(friend)}/> {buddyStatus(friend)} · @{friend.username}</span></div><button className="icon-btn close-chat" title="Close chat" onClick={()=>{setOpenChats(old=>old.filter(x=>x!==id));if(active===id)setActive(null)}}><X size={17}/></button></div><div className="chat-toolbar"><button title="Send a nudge" onClick={()=>void nudge(id)}><Zap size={14}/> Nudge</button><button onClick={()=>exportChat(id)} title="Save message history"><Download size={14}/> History</button><label title="Conversation background"><Palette size={14}/><select value={chatStyle} onChange={e=>setChatStyle(e.target.value as typeof chatStyle)}><option value="blue">Blue</option><option value="rose">Rose</option><option value="mint">Mint</option></select></label></div><div className="messages font-chat" data-message-font={messageFont} aria-live="polite">{(messages[id]??[]).length===0&&<p className="empty-chat">It's quiet here. Say hello!</p>}{(messages[id]??[]).map(m=><div className="message" key={m.id}><div className={'message-author '+(m.sender_id===user.id?'me':'')}><strong>{m.sender_id===user.id?display(profile):display(friend)} says:</strong><time>{dateTime(m.created_at)}</time></div><p><EmoteText body={m.body}/></p></div>)}{(events[id]||[]).map(ev=><p className="nudge-event" key={ev.id}><Zap size={13}/> {ev.sender_id===user.id?'You sent a nudge!':`${display(friend)} sent you a nudge!`}</p>)}</div><div className="composer"><div className="composer-tools"><button type="button" title="Emoticons" onClick={()=>setEmoteOpen(old=>old===id?null:id)}><Smile size={16}/> Emoticons</button>{emoteOpen===id&&<div className="emote-panel">{EMOTES.map(([emoji,shortcut])=><button key={shortcut} type="button" title={shortcut} onClick={()=>insertEmote(id,shortcut)}>{emoji}</button>)}</div>}</div><form onSubmit={e=>{e.preventDefault();void send(id)}}><textarea aria-label="Message" value={drafts[id]??''} maxLength={2000} onChange={e=>setDrafts(old=>({...old,[id]:e.target.value}))} onKeyDown={e=>{if(e.key==='Enter'&&!e.shiftKey){e.preventDefault();void send(id)}}} placeholder={`Message ${display(friend)}...`}/><button className="xp-button primary" disabled={!(drafts[id]??'').trim()}><Send size={14}/> Send</button></form></div></div>};
  if(showOnlyChat)return <main className="desktop chat-only" data-interface-font={interfaceFont}>{chatView(chatQuery!)}</main>;
  return <div className="desktop" data-interface-font={interfaceFont}><div className="app-shell"><section className="xp-window buddy-window"><Header>Retro Messenger — Contacts</Header><div className="menu-bar"><span>File</span><span>Contacts</span><span>Actions</span><span>Tools</span><span>Help</span></div><div className="my-profile"><Avatar person={profile}/><div className="profile-text"><strong>{display(profile)}</strong><small>@{profile.username}</small><span>{profile.personal_message||'Share a personal message…'}</span></div><select title="Your status" value={profile.status_preference} onChange={e=>void setStatus(e.target.value as Status)}><option value="online">Online</option><option value="away">Away</option><option value="busy">Busy</option><option value="invisible">Appear Offline</option></select></div><div className="action-strip"><button className="xp-button" onClick={openSettings}><Settings size={14}/> Options</button><button className="xp-button" onClick={()=>{document.querySelector<HTMLInputElement>('#buddy-search')?.focus()}}><UserRoundPlus size={14}/> Add Contact</button><button className="xp-button" title="Sign out" onClick={()=>void logout()}><LogOut size={14}/></button></div><div className="search-row"><Search size={15}/><input id="buddy-search" placeholder="Search usernames to add contacts…" value={search} onChange={e=>setSearch(e.target.value)}/></div>{error&&<div className="error-message" role="alert">{error}<button onClick={()=>setError('')} aria-label="Dismiss"><X size={13}/></button></div>}<div className="buddy-list">{received.length>0&&<div className="requests"><h3><Bell size={15}/> Contact requests ({received.length})</h3>{received.map(r=>{const p=profiles.find(x=>x.id===r.sender_id);return <div className="request-row" key={r.id}><span>@{p?.username??'Unknown'}</span><button disabled={pending} onClick={()=>void respond(r.id,true)}>Accept</button><button disabled={pending} onClick={()=>void respond(r.id,false)}>Decline</button></div>})}</div>}{search.trim()&&<div className="search-results"><h3>Find contacts</h3>{candidates.length===0&&<p>No usernames found.</p>}{candidates.map(p=><div className="find-row" key={p.id}><span>{display(p)} <small>@{p.username}</small></span><button className="xp-button" disabled={pending||requestedByMe.has(p.id)} onClick={()=>void requestContact(p.id)}>{requestedByMe.has(p.id)?'Requested':'Add +'}</button></div>)}</div>}<h3><ChevronDown size={15}/> Online ({contacts.filter(c=>buddyStatus(c)!=='offline').length})</h3>{contacts.filter(c=>buddyStatus(c)!=='offline').sort((a,b)=>(groupMap[a.id]||'Friends').localeCompare(groupMap[b.id]||'Friends')).map(c=><ContactRow key={c.id} person={c} status={buddyStatus(c)} onOpen={()=>void openChat(c.id)} onRemove={()=>void removeContact(c.id)} onBlock={()=>void blockContact(c.id)} group={groupMap[c.id]||'Friends'} onGroup={value=>setGroup(c.id,value)}/>)}<h3><ChevronDown size={15}/> Offline ({contacts.filter(c=>buddyStatus(c)==='offline').length})</h3>{contacts.filter(c=>buddyStatus(c)==='offline').sort((a,b)=>(groupMap[a.id]||'Friends').localeCompare(groupMap[b.id]||'Friends')).map(c=><ContactRow key={c.id} person={c} status="offline" onOpen={()=>void openChat(c.id)} onRemove={()=>void removeContact(c.id)} onBlock={()=>void blockContact(c.id)} group={groupMap[c.id]||'Friends'} onGroup={value=>setGroup(c.id,value)}/>)}{contacts.length===0&&<p className="no-contacts">Your contact list is empty.<br/>Search for a username to add your first friend.</p>}</div><div className="buddy-footer"><Circle size={10} fill="#65b845" color="#65b845"/> Signed in · {contacts.length} contacts</div></section>{!isTauri()&&openChats.length>0&&<section className="chat-grid">{openChats.map(id=>chatView(id))}</section>}</div>{settings&&<div className="modal-backdrop" onClick={()=>setSettings(false)}><div className="xp-window settings-window messenger-settings-window" onClick={e=>e.stopPropagation()}><Header>Messenger Options</Header><div className="settings-layout"><aside className="settings-sidebar"><button type="button" className={settingsTab==='personal'?'active':''} onClick={()=>setSettingsTab('personal')}>Personal</button><button type="button" className={settingsTab==='appearance'?'active':''} onClick={()=>setSettingsTab('appearance')}>Fonts & appearance</button><button type="button" className={settingsTab==='sounds'?'active':''} onClick={()=>setSettingsTab('sounds')}>Sounds</button></aside><form onSubmit={saveProfile} className="stack-form setting-form">{settingsTab==='personal'&&<><div className="avatar-editor"><div className="avatar preview-avatar">{!removeAvatar&&(avatarPreview||profile.avatar_url)?<img src={avatarPreview||profile.avatar_url||''} alt="Profile picture preview"/>:display(profile)[0]?.toUpperCase()}</div><div className="avatar-picker"><strong>Display picture</strong><span>JPG, PNG or WebP · Maximum 2 MB</span><label className="xp-button avatar-upload"><Camera size={15}/> Choose picture<input type="file" accept="image/png,image/jpeg,image/webp" onChange={e=>{selectAvatar(e.target.files?.[0]);e.currentTarget.value=''}}/></label>{(profile.avatar_url||newAvatar)&&<button type="button" className="xp-button remove-avatar" onClick={()=>{setNewAvatar(null);setRemoveAvatar(true)}}><Trash2 size={13}/> Remove picture</button>}</div></div>{cropping&&avatarPreview&&<div className="crop-panel"><strong>Crop display picture</strong><div className="crop-picture" style={{backgroundImage:`url(${avatarPreview})`,backgroundSize:`${cropZoom*100}% auto`}}/><label>Zoom <input type="range" min="1" max="3" step="0.1" value={cropZoom} onChange={e=>setCropZoom(Number(e.target.value))}/></label><button type="button" className="xp-button primary" onClick={()=>void cropImage()}>Apply square crop</button><canvas ref={cropCanvas} hidden/></div>}{avatarError&&<p className="notice" role="alert">{avatarError}</p>}{error&&<p className="notice" role="alert">{error}</p>}<label>Display name<input value={newDisplay} maxLength={40} required onChange={e=>setNewDisplay(e.target.value)}/></label><label>Personal message<input value={newPersonal} maxLength={100} onChange={e=>setNewPersonal(e.target.value)}/></label></>}{settingsTab==='appearance'&&<div className="settings-panel"><label>Interface font<select value={interfaceFont} onChange={e=>setInterfaceFont(e.target.value as InterfaceFont)}><option value="tahoma">Tahoma (classic MSN)</option><option value="verdana">Verdana</option><option value="arial">Arial</option><option value="trebuchet">Trebuchet MS</option></select></label><label>Conversation font<select value={messageFont} onChange={e=>setMessageFont(e.target.value as MessageFont)}><option value="ms-sans">Microsoft Sans Serif</option><option value="tahoma">Tahoma</option><option value="comic">Comic Sans MS</option><option value="verdana">Verdana</option><option value="georgia">Georgia</option></select></label><label>Conversation background<select value={chatStyle} onChange={e=>setChatStyle(e.target.value as typeof chatStyle)}><option value="blue">Messenger blue</option><option value="rose">Rose</option><option value="mint">Mint</option></select></label><div className="font-preview-card" data-message-font={messageFont}><strong>Preview</strong><p className="preview-contact">CJayStreamz says:</p><p>Hello! This is how your Retro Messenger text will look.</p></div></div>}{settingsTab==='sounds'&&<div className="settings-panel"><label className="sound-setting"><input type="checkbox" checked={soundEnabled} onChange={e=>setSoundEnabled(e.target.checked)}/>{soundEnabled?<Volume2 size={16}/>:<VolumeX size={16}/>} Play message sounds</label><p className="settings-help">When enabled, Retro Messenger plays a classic-style alert when you receive a new message or nudge.</p></div>}<div className="settings-actions"><button className="xp-button" type="button" onClick={()=>setSettings(false)}>Close</button><button className="xp-button primary" disabled={pending}>{pending?'Saving…':'Save changes'}</button></div></form></div></div></div>}<div className="desktop-footer">Retro Messenger · Bringing back the good old days.</div></div>;
}
function ContactRow({person,status,onOpen,onRemove,onBlock,group,onGroup}:{person:Profile,status:Status|'offline',onOpen:()=>void,onRemove:()=>void,onBlock:()=>void,group:string,onGroup:(value:string)=>void}) {return <div className="contact-row"><button onClick={onOpen} title={`Chat with ${display(person)}`}><span className="contact-avatar-wrap"><Avatar person={person} small/><StatusDot status={status}/></span><span>{display(person)} <small className="group-name">[{group}]</small> <small>{person.personal_message?`— ${person.personal_message}`:''}</small></span></button><details><summary title="Contact options">•••</summary><div className="contact-menu"><button onClick={onOpen}>Message</button><label className="group-option">Group<select value={group} onChange={e=>onGroup(e.target.value)}><option>Friends</option><option>Family</option><option>Work</option><option>Other</option></select></label><button onClick={()=>{if(window.confirm('Remove this contact?'))onRemove()}}>Remove</button><button onClick={()=>{if(window.confirm('Block this contact?'))onBlock()}}>Block</button></div></details></div>}
