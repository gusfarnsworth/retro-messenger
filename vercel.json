{
  "rewrites": [
    {
      "source": "/reset-password",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/updates.json",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, OPTIONS"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
